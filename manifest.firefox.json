{
  "manifest_version": 3,
  "name": "OTNow",
  "short_name": "OTNow",
  "version": "1.6.1",
  "description": "An unofficial, private-by-default Canvas deadline sidebar for Ontario Tech students.",
  "homepage_url": "https://github.com/sil6428/OTNow",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open OTNow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "sidebar_action": {
    "default_title": "OTNow",
    "default_panel": "panel/panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "open_at_install": false
  },
  "options_page": "options/options.html",
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://learn.ontariotechu.ca/*"
  ],
  "optional_host_permissions": [
    "https://otnow-stats.sil6428-archtech.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://learn.ontariotechu.ca/*"
      ],
      "js": [
        "src/content/canvas-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "otnow@sil6428.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  }
}
