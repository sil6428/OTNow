{
  "manifest_version": 3,
  "name": "OTNow",
  "short_name": "OTNow",
  "version": "0.4.0",
  "description": "An unofficial, private-by-default Canvas deadline panel for Ontario Tech students.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open OTNow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://learn.ontariotechu.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://learn.ontariotechu.ca/*"
      ],
      "js": [
        "src/content/canvas-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
